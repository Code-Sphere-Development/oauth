{
    "name": "code-sphere/oauth",
    "description": "OAuth2 client package for CodeSphere Accounts. Stateless identity, group membership, and team checks for all CodeSphere apps.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "oauth",
        "codesphere",
        "sso"
    ],
    "homepage": "https://github.com/Code-Sphere-Development/oauth",
    "authors": [
        {
            "name": "Collin Ilgner",
            "email": "cilgner@code-sphere.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "CodeSphere\\OAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeSphere\\OAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeSphere\\OAuth\\OAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.1",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
